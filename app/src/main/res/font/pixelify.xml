<?xml version="1.0" encoding="utf-8"?>
<!-- Pixelify Sans (SIL Open Font License) - fonte pixel dos textos -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/pixelify_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/pixelify_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/pixelify_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/pixelify_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
