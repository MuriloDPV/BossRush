<?xml version="1.0" encoding="utf-8"?>
<!-- Trilho do interruptor de som: verde ligado, vinho desligado -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="46dp" android:height="16dp" />
            <solid android:color="#5F9E45" />
            <stroke android:width="2dp" android:color="#16142E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="46dp" android:height="16dp" />
            <solid android:color="#3C1E28" />
            <stroke android:width="2dp" android:color="#16142E" />
        </shape>
    </item>
</selector>
