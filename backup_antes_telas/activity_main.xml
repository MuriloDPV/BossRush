<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Boss Rush"
            android:textColor="#F9FAFB"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Progresso: 0/5 mestres"
            android:textColor="#D1D5DB"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Nova partida" />

            <Button
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Continuar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Configurações" />

                <Button
                    android:id="@+id/codesButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Códigos" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/effectsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Efeitos" />

                <Button
                    android:id="@+id/resetButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Reiniciar" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Configurações"
            android:textColor="#F9FAFB"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Efeitos sonoros"
                android:textColor="#F3F4F6"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/soundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Volume dos efeitos sonoros"
            android:textColor="#F3F4F6"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/volumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="70" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Volume da música"
            android:textColor="#F3F4F6"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/musicVolumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="70" />

        <Button
            android:id="@+id/settingsBackButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Voltar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codesLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/codesScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Códigos"
                    android:textColor="#F9FAFB"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/codeInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="#1F2937"
                    android:hint="Digite o código"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="#F9FAFB"
                    android:textColorHint="#9CA3AF"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/redeemCodeButton"
                    android:layout_width="220dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Resgatar Código" />

                <TextView
                    android:id="@+id/codeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:minHeight="24dp"
                    android:text=""
                    android:textColor="#D1D5DB"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Códigos desbloqueados"
                    android:textColor="#F9FAFB"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/unlockedCodesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/codesBackButton"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Voltar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/effectsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/effectsScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/effectsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />
        </ScrollView>

        <Button
            android:id="@+id/effectsBackButton"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Voltar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/battleLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1B223C"
        android:orientation="vertical"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Cenário da área atual (Reino, Planície, Floresta Densa, Caverna) -->
            <ImageView
                android:id="@+id/arenaBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/area_reino" />

            <!-- Herói (altura ajustada no código) -->
            <ImageView
                android:id="@+id/heroSprite"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="56dp"
                android:layout_marginBottom="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Herói"
                android:src="@drawable/heroi" />

            <!-- Chefe atual (imagem e altura trocadas no código) -->
            <ImageView
                android:id="@+id/bossSprite"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="12dp"
                android:layout_toStartOf="@+id/actionGroup"
                android:adjustViewBounds="true"
                android:contentDescription="Chefe"
                android:src="@drawable/chefe_bandido" />

            <TextView
                android:id="@+id/bossNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:background="@drawable/hud_panel"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:text="Reino — Bandido"
                android:textColor="#FFE08A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/playerStatusColumn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="12dp"
                android:layout_marginTop="56dp"
                android:background="@drawable/hud_panel"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Herói  "
                        android:textColor="#FFE08A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playerHpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100/100"
                        android:textColor="#F5F0E1"
                        android:textSize="14sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/playerHealthBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="200dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="100"
                    android:progressBackgroundTint="#3C1E28"
                    android:progressTint="#50BE5A" />

                <TextView
                    android:id="@+id/playerStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="efeitos no herói:"
                    android:textColor="#F5F0E1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/healText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="quantidade de cura: 3"
                    android:textColor="#F5F0E1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/specialAttackText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ataque especial: disponível"
                    android:textColor="#F5F0E1"
                    android:textSize="13sp" />

                <!-- Mantido para o código, mas escondido (repetia a linha de cima) -->
                <TextView
                    android:id="@+id/specialAttackCooldownText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="disponível"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bossStatusColumn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/hud_panel"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chefe  "
                        android:textColor="#FFE08A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/bossHpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textColor="#F5F0E1"
                        android:textSize="14sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/bossHealthBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="200dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="100"
                    android:progressBackgroundTint="#3C1E28"
                    android:progressTint="#E04A4A" />

                <TextView
                    android:id="@+id/bossStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="efeitos no chefe"
                    android:textColor="#F5F0E1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cardCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="cartas: 0"
                    android:textColor="#F5F0E1"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/battleSettingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_config_sel"
                android:contentDescription="Configurações" />

            <!-- Botões de ação em pixel art (2x2) -->
            <LinearLayout
                android:id="@+id/actionGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/specialAttackButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/btn_especial_sel"
                        android:contentDescription="Ataque especial" />

                    <ImageButton
                        android:id="@+id/healButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/btn_cura_sel"
                        android:contentDescription="Cura" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/shieldButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/btn_escudo_sel"
                        android:contentDescription="Escudo" />

                    <ImageButton
                        android:id="@+id/swordButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/btn_espada_sel"
                        android:contentDescription="Espada" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Escolha uma carta"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/cardButtonA"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#292E32"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/cardButtonB"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#292E32"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/cardButtonC"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#292E32"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/victoryLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/victoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Chefe derrotado!"
            android:textColor="#F9FAFB"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/nextBossButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Próximo chefe" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Voltar ao menu" />
    </LinearLayout>
</LinearLayout>
